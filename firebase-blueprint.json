{
  "entities": {
    "UserProfile": {
      "title": "Student Profile",
      "description": "Private profile and study preferences for a Bangladeshi HSC Science / Medical Admission student.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "email": {
          "type": "string",
          "maxLength": 200
        },
        "targetExam": {
          "type": "string",
          "enum": ["medical", "dental", "hsc_science"]
        },
        "hscClass": {
          "type": "string",
          "enum": ["11", "12", "admission"]
        },
        "college": {
          "type": "string",
          "maxLength": 150
        },
        "photoUrl": {
          "type": "string",
          "maxLength": 1000
        },
        "dailyGoal": {
          "type": "number"
        },
        "accountStatus": {
          "type": "string",
          "enum": ["active", "suspended"]
        },
        "adminNote": {
          "type": "string",
          "maxLength": 300
        },
        "accessTier": {
          "type": "string",
          "enum": ["free_trial", "enrolled_pro", "lifetime_vip", "restricted"]
        },
        "accessStartsAt": {
          "type": "string",
          "format": "date-time"
        },
        "accessExpiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "displayName", "email", "targetExam", "hscClass", "dailyGoal", "createdAt", "updatedAt"]
    },
